# .gitignore — 为什么需要：
# 1. 产物不入库：报告、截图、trace 是每次运行的输出，入库只会污染历史
# 2. 本地环境不入库：虚拟环境、缓存因机器而异
# 3. 敏感信息不入库：未来若引入真实环境凭证（.env），必须屏蔽

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/

# 测试产物（M7/M8 生成）
# reports/ 整目录忽略会让 .gitkeep 失效（全面复审 P3-1：目录占位符
# 被吞，README「每个空目录有 gitkeep」承诺落空）——改为忽略内容、
# 例外放行 .gitkeep；其余三个目录当前无占位符，保持整目录忽略
reports/*
!reports/.gitkeep
screenshots/
traces/
allure-results/

# Playwright 浏览器二进制（约 300MB，安装脚本按需下载，绝不入库）
.playwright-browsers/

# 工具二进制不入库（chromedriver 为 Selenium 时代残留，本项目用 Playwright 不需要）
chromedriver.exe

# 本地环境配置（真实凭证走环境变量，不入库）
.env

# IDE
.idea/
.vscode/

# AI 工具会话记忆（内部工作数据，与项目交付无关）
.workbuddy/

# ---- 与项目交付无关的私有文件（不入库，但保留在本地磁盘）----
# 说明：本段是"屏蔽"而非"删除"——文件仍在工作区可读，只是不进入版本历史。
# 若需重新纳入版本控制：git add -f <路径>

# 学习作业/题目作答（个人学习痕迹，非项目交付物）
homework/

# 临时诊断脚本与输出（排查一次性问题时产生，曾两次出现在仓库根目录；
# 限定根目录一级、以下划线开头，避免误伤 tests/ 下 __init__.py 等正常文件）
/_*.py
/_*.txt
/_*.log

